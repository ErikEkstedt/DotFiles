# SSH Config Template
# Copy to ~/.ssh/config and fill in your host details.
# install.sh creates this file automatically if ~/.ssh/config doesn't exist.

# macOS Keychain integration — auto-loads keys, no passphrase prompts
# Run once to store: ssh-add --apple-use-keychain ~/.ssh/id_ed25519
Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

# Dev server (fill in after provisioning)
Host devserver
    HostName <ip-or-hostname>
    User <username>
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ForwardAgent yes

# GitHub
Host github.com
    HostName github.com
