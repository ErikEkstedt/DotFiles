# SSH Config Template
# Copy to ~/.ssh/config and fill in your host details.
# install.sh creates this file automatically if ~/.ssh/config doesn't exist.

# Dev server (fill in after provisioning)
Host devserver
    HostName <ip-or-hostname>
    User <username>
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ForwardAgent yes

# GitHub (no changes needed)
Host github.com
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
